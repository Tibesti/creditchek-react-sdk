{
    "compilerOptions": {
      "target": "ES5",
      "module": "CommonJS",
      "lib": ["dom", "esnext"],
      "declaration": true,
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "node"
    },
    "include": ["src"]
  }