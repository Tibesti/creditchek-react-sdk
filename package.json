{
  "name": "@creditcliq/react-sdk",
  "version": "2.0.1",
  "description": "React SDK for the CreditChek verification widget: identity, liveness, credit, income and Recova in a few lines of code.",
  "keywords": [
    "creditchek",
    "react",
    "kyc",
    "bvn",
    "nin",
    "liveness",
    "identity-verification",
    "credit-report",
    "widget"
  ],
  "homepage": "https://github.com/creditcliq/approval-web#readme",
  "bugs": {
    "url": "https://github.com/creditcliq/approval-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creditcliq/approval-web.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "ISC",
  "author": "Tobiloba Olugbemi",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run lint:package"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
